+    const module = resolveModuleSync(options.wasm);
+    const inst = new QuickJSInstance(module, owned);
+    const imports = inst.createImports(options.wasi);
+    // attach() binds the memory the WASI shim and the memory proxy use,
+    // before _initialize and the first VM call into them.
+    inst.attach(new WebAssembly.Instance(module, imports));
+    inst._exports._initialize();
+    if (options.extensions) {
+      const mainExports = inst._exports as unknown as Record<string, WebAssembly.ExportValue>;
+      for (const desc of options.extensions) {
+        inst._loadedExtensions.push(
+          loadExtensionSync(desc, mainExports, inst._wasiBuiltins, inst._wasiUserOverrides, inst._memoryProxy),
+        );
+      }
+    }
+    return inst;
+  }
