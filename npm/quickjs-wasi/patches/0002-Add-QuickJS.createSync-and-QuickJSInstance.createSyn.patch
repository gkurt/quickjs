diff --git a/test/create-sync.test.ts b/test/create-sync.test.ts
new file mode 100644
index 0000000..45e2dd2
--- /dev/null
+++ b/test/create-sync.test.ts
@@ -0,0 +1,89 @@
+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { QuickJS, QuickJSInstance } from '../src/index.ts';
+import { wasmBytes } from './helpers.ts';
+
+const wasm = new WebAssembly.Module(wasmBytes);
+const encodingBytes = readFileSync(new URL('../extensions/encoding/encoding.so', import.meta.url));
+const urlBytes = readFileSync(new URL('../extensions/url/url.so', import.meta.url));
+
+describe('QuickJS.createSync', () => {
+  it('creates a VM without awaiting', () => {
+    const vm = QuickJS.createSync({ wasm });
+    expect(vm.evalCode('[1, 2, 3].map(x => x * 2).join()').consume((h) => h.toString())).toBe('2,4,6');
+    vm.dispose();
+  });
+
+  it('accepts a module directly, and bytes', () => {
+    using a = QuickJS.createSync(wasm);
+    using b = QuickJS.createSync({ wasm: wasmBytes });
+    expect(a.evalCode('1 + 1').consume((h) => h.toNumber())).toBe(2);
+    expect(b.evalCode('2 + 2').consume((h) => h.toNumber())).toBe(4);
+  });
+
+  it('applies the VM options', () => {
+    let deadline = Date.now() + 30;
+    using vm = QuickJS.createSync({ wasm, memoryLimit: 4 << 20, interruptHandler: () => Date.now() > deadline });
+    expect(() => vm.evalCode('while (true) {}')).toThrow(/interrupted/);
+    deadline = Infinity;
+    expect(vm.getMemoryUsage().mallocLimit).toBe(4 << 20);
+  });
+
+  it('binds the WASI memory before the module first calls into WASI', () => {
+    const seen: number[] = [];
+    using vm = QuickJS.createSync({
+      wasm,
+      // the memory proxy must work from the very first call: the runtime
+      // reads the clock while it is created
+      wasi: (memory) => ({
+        clock_time_get(_id: number, _precision: bigint, resultPtr: number) {
+          seen.push(memory.buffer.byteLength);
+          new DataView(memory.buffer).setBigUint64(resultPtr, 1_700_000_000_000n * 1_000_000n, true);
+          return 0;
+        },
+      }),
+    });
+    expect(seen.length).toBeGreaterThan(0);
+    expect(seen.every((n) => n > 0)).toBe(true);
+    expect(vm.evalCode('Date.now()').consume((h) => h.toNumber())).toBe(1_700_000_000_000);
+  });
+
+  it('loads extensions from compiled modules and from bytes', () => {
+    using vm = QuickJS.createSync({
+      wasm,
+      extensions: [
+        { name: 'encoding', wasm: new WebAssembly.Module(encodingBytes) },
+        { name: 'url', wasm: urlBytes },
+      ],
+    });
+    expect(vm.evalCode('new TextDecoder().decode(new TextEncoder().encode("héllo"))').consume((h) => h.toString())).toBe('héllo');
+    expect(vm.evalCode('new URL("../b?q=1", "https://x.test/a/c").href').consume((h) => h.toString())).toBe('https://x.test/b?q=1');
+  });
+
+  it('snapshots and restores like an async VM', async () => {
+    const vm = QuickJS.createSync({ wasm });
+    vm.evalCode('globalThis.n = 41').dispose();
+    const snapshot = vm.snapshot();
+    vm.dispose();
+    using restored = await QuickJS.restore(snapshot, { wasm });
+    expect(restored.evalCode('n + 1').consume((h) => h.toNumber())).toBe(42);
+  });
+
+  it('throws a clear error without a module', () => {
+    expect(() => QuickJS.createSync({ wasm: undefined } as any)).toThrow(/`wasm` option is required/);
+    expect(() => QuickJS.createSync({ wasm: Promise.resolve(wasm) as any })).toThrow(/must be a compiled WebAssembly.Module/);
+  });
+});
+
+describe('QuickJSInstance.createSync', () => {
+  it('creates an instance for several VMs without awaiting', () => {
+    using inst = QuickJSInstance.createSync({ wasm, extensions: [{ name: 'encoding', wasm: encodingBytes }] });
+    const a = inst.newVm();
+    const b = inst.newVm({ memoryLimit: 8 << 20 });
+    a.evalCode('globalThis.x = new TextEncoder().encode("ab").length').dispose();
+    expect(a.evalCode('x').consume((h) => h.toNumber())).toBe(2);
+    expect(b.evalCode('typeof x').consume((h) => h.toString())).toBe('undefined');
+    a.dispose();
+    b.dispose();
+  });
+});
