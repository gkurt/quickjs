-    'and can be loaded via your environment\'s preferred mechanism (e.g. ' +
-    "`fetch()`, `node:fs/promises`, or a bundler import like Vite's `?url`).",
-  );
+  throw new TypeError(MISSING_WASM_MESSAGE);
+}
+
+function resolveModuleSync(wasmInput?: BufferSource | WebAssembly.Module): WebAssembly.Module {
+  if (wasmInput instanceof WebAssembly.Module) {
+    return wasmInput;
+  }
+  if (!wasmInput) {
+    throw new TypeError(MISSING_WASM_MESSAGE);
+  }
+  if (!(wasmInput instanceof ArrayBuffer) && !ArrayBuffer.isView(wasmInput)) {
+    throw new TypeError(
+      'QuickJS.createSync: `wasm` must be a compiled WebAssembly.Module (or WASM bytes); ' +
+      `got ${typeof (wasmInput as unknown as PromiseLike<unknown>)?.then === 'function' ? 'a Promise' : typeof wasmInput}`,
+    );
+  }
+  return new WebAssembly.Module(wasmInput);
 }
 
