+   * whether the module name ends in `.ts`, `.mts` or `.cts`.
+   */
+  typescript?: boolean;
+}
+
+/** Whether a module of this name is TypeScript by default. */
+function isTypeScriptModuleName(name: string): boolean {
+  return /\.[mc]?ts$/.test(name);
+}
