@@ -1505,15 +1525,25 @@ export class QuickJS {
   }
 
   /** @internal host_module_load */
-  _hostModuleLoad(namePtr: number, outLenPtr: number): number {
+  _hostModuleLoad(namePtr: number, outLenPtr: number, outTypeScriptPtr: number): number {
     // Return source code for a module: a malloc'd string pointer, with
-    // its length written to *outLenPtr.
+    // its length written to *outLenPtr and whether it is TypeScript to
+    // *outTypeScriptPtr.
     if (!this.moduleLoadHandler) return 0;
     const name = this.readCString(namePtr);
     try {
-      const source = assertSyncString(this.moduleLoadHandler(name), 'load');
+      const loaded = this.moduleLoadHandler(name);
+      let source: string;
+      let typescript = isTypeScriptModuleName(name);
+      if (typeof loaded === 'object' && loaded !== null && typeof (loaded as ModuleSource).source === 'string') {
+        source = loaded.source;
+        if (loaded.typescript !== undefined) typescript = !!loaded.typescript;
+      } else {
+        source = assertSyncString(loaded, 'load', ' or a { source, typescript? } object');
+      }
       const { ptr, len } = this.writeString(source);
       new Uint32Array(this.exports.memory.buffer, outLenPtr, 1)[0] = len;
+      new Int32Array(this.exports.memory.buffer, outTypeScriptPtr, 1)[0] = typescript ? 1 : 0;
       return ptr;
     } catch (err) {
       this.throwIntoContext(err);
diff --git a/test/typescript.test.ts b/test/typescript.test.ts
index da51cf7..bc58724 100644
--- a/test/typescript.test.ts
+++ b/test/typescript.test.ts
@@ -1,5 +1,5 @@
 import { describe, it, expect } from 'vitest';
-import { QuickJS, EvalFlags } from '../src/index.ts';
+import { QuickJS, EvalFlags, type ModuleSource } from '../src/index.ts';
 import { wasmBytes } from './helpers.ts';
 
 const wasm = new WebAssembly.Module(wasmBytes);
@@ -67,3 +67,75 @@ describe('EvalFlags.TYPESCRIPT', () => {
     expect(vm.evalBytecode(bytecode).consume((h) => h.toString())).toBe('ok');
   });
 });
+
+describe('TypeScript modules', () => {
+  const tsUtil = 'export function twice<T extends number>(n: T): number { return (n as number) * 2 }\nexport type Unused = { a: string };';
+  const sources: Record<string, string | ModuleSource> = {
+    'util.ts': tsUtil,
+    'util.mts': tsUtil,
+    'util.cts': tsUtil,
+    'typed.js': tsUtil,
+    'forced.js': { source: tsUtil, typescript: true },
+    'plain.ts': { source: 'export const v = 1 < 2 ? "js" : "?"', typescript: false },
+    'notreally.ts': { source: tsUtil, typescript: false },
+    'bad.ts': { source: 42 } as unknown as ModuleSource,
+  };
+  const makeVm = () => QuickJS.createSync({
+    wasm,
+    moduleLoader: {
+      load: (name) => {
+        if (!(name in sources)) throw new Error(`no module ${name}`);
+        return sources[name];
+      },
+    },
+  });
+
+  // Evaluate a module and return its `out` export, or throw its error
+  const importOut = async (vm: QuickJS, code: string): Promise<string> => {
+    const p = vm.evalCode(code, 'main.js', EvalFlags.TYPE_MODULE);
+    vm.executePendingJobs();
+    const settled = await vm.resolvePromise(p);
+    p.dispose();
+    if ('error' in settled) {
+      const message = settled.error.consume((h) => h.getProp('message').consume((m) => m.toString()));
+      throw new Error(message);
+    }
+    return settled.value.consume((ns) => ns.getProp('out').consume((h) => h.toString()));
+  };
+
+  it('compiles imported .ts, .mts and .cts modules as TypeScript', async () => {
+    using vm = makeVm();
+    for (const ext of ['ts', 'mts', 'cts']) {
+      const run = importOut(vm, `import { twice } from "util.${ext}"; export const out = String(twice(21));`);
+      if (typescriptSupported) {
+        expect(await run).toBe('42');
+      } else {
+        await expect(run).rejects.toThrow(/TypeScript is not supported/);
+      }
+    }
+  });
+
+  it('compiles other names as JavaScript', async () => {
+    using vm = makeVm();
+    await expect(importOut(vm, 'import { twice } from "typed.js"; export const out = "";')).rejects.toThrow(/./);
+  });
+
+  it('lets load() decide with { source, typescript }', async () => {
+    using vm = makeVm();
+    const forced = importOut(vm, 'import { twice } from "forced.js"; export const out = String(twice(2));');
+    if (typescriptSupported) {
+      expect(await forced).toBe('4');
+    } else {
+      await expect(forced).rejects.toThrow(/TypeScript is not supported/);
+    }
+    expect(await importOut(vm, 'import { v } from "plain.ts"; export const out = v;')).toBe('js');
+    await expect(importOut(vm, 'import { twice } from "notreally.ts"; export const out = "";')).rejects.toThrow(/./);
+  });
+
+  it('rejects a load() result that is neither a string nor a module source', async () => {
+    using vm = makeVm();
+    await expect(importOut(vm, 'import "bad.ts"; export const out = "";')).rejects.toThrow(
+      /must synchronously return a string \(got type object\) or a \{ source, typescript\? \} object/,
+    );
+  });
+});
