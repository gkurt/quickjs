From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 11:50:16 +0000
Subject: [PATCH 4/8] Compile .ts, .mts and .cts modules as TypeScript

The module loader compiled every loaded module as JavaScript, so an
imported TypeScript module failed with a syntax error on its first type
annotation.

A module whose name ends in .ts, .mts or .cts is now compiled with
JS_EVAL_FLAG_TYPESCRIPT. moduleLoader.load may return
{ source, typescript? } instead of a string, to decide either way. The
host tells the trampoline through a new out parameter of
host_module_load. A build without TypeScript rejects such a module with
the engine's "TypeScript is not supported in this build" SyntaxError.
---
 c/interface.c           | 17 +++++++---
 src/index.ts            | 50 ++++++++++++++++++++++------
 test/typescript.test.ts | 74 ++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 125 insertions(+), 16 deletions(-)

diff --git a/c/interface.c b/c/interface.c
index f8fd226..0374075 100644
--- a/c/interface.c
+++ b/c/interface.c
@@ -151,9 +151,11 @@ extern char *host_module_normalize(QJSVm *vm, const char *base_name, const char
  * The host writes the source code into WASM memory and returns a pointer
  * to a null-terminated source string (allocated with malloc).
  * The caller frees it. Returns NULL on error.
+ * The host sets *out_typescript to 1 if the source is TypeScript, to be
+ * compiled with JS_EVAL_FLAG_TYPESCRIPT.
  */
 __attribute__((import_module("env"), import_name("host_module_load")))
-extern char *host_module_load(QJSVm *vm, const char *module_name, size_t *out_len);
+extern char *host_module_load(QJSVm *vm, const char *module_name, size_t *out_len, int *out_typescript);
 
 /*
  * Module normalizer trampoline: dispatches to the host_module_normalize import.
@@ -198,8 +200,9 @@ static JSModuleDef *module_loader_trampoline(JSContext *ctx,
 {
     (void)opaque;
     size_t source_len = 0;
+    int typescript = 0;
     QJSVm *saved = cur_vm;
-    char *source = host_module_load(qjs_vm_of(ctx), module_name, &source_len);
+    char *source = host_module_load(qjs_vm_of(ctx), module_name, &source_len, &typescript);
     qjs_activate(saved);
     if (!source) {
         /* The host may have already thrown a more specific error via
@@ -210,9 +213,13 @@ static JSModuleDef *module_loader_trampoline(JSContext *ctx,
         return NULL;
     }
 
-    /* Compile the module source (COMPILE_ONLY so it returns the module def) */
-    JSValue func_val = JS_Eval(ctx, source, source_len, module_name,
-                                JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY);
+    /* Compile the module source (COMPILE_ONLY so it returns the module
+       def). A build without TypeScript rejects the flag with a
+       SyntaxError. */
+    int eval_flags = JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY;
+    if (typescript)
+        eval_flags |= JS_EVAL_FLAG_TYPESCRIPT;
+    JSValue func_val = JS_Eval(ctx, source, source_len, module_name, eval_flags);
     free(source);
 
     if (JS_IsException(func_val)) {
