diff --git a/c/interface.c b/c/interface.c
index 0374075..0cb051f 100644
--- a/c/interface.c
+++ b/c/interface.c
@@ -41,6 +41,7 @@ typedef struct QJSVm {
     size_t mem_limit;   /* 0 = unlimited */
     size_t mem_used;    /* sum of malloc_usable_size of live allocs */
     int mem_in_oom;     /* a refusal happened; headroom is open */
+    uintptr_t stack_top; /* the stack pointer where the VM was created */
     QJSBox boxes;       /* head of the list of live boxes */
 } QJSVm;
 
@@ -550,6 +551,32 @@ static JSContext *qjs_new_context(JSRuntime *rt, unsigned int intrinsics) {
     return ctx;
 }
 
+/* ---- Stack ----
+ *
+ * The instance has one stack (linked with -z stack-size=2097152), shared
+ * by its VMs: a VM running from the host function of another VM runs
+ * deeper in the same stack. A runtime measures its stack limit
+ * (JS_SetMaxStackSize) from the stack pointer at its creation, which is
+ * near the top of the stack for a VM created by the host at top level,
+ * but deeper for one created from a host function. Keep the limit of
+ * every VM above the bottom of the stack, with QJS_STACK_MARGIN of room
+ * for the frames that throw the "Maximum call stack size exceeded"
+ * error: a limit below the bottom would let the stack overflow into the
+ * data below it (and the engine ignores a limit larger than the stack
+ * top, which would disable the check).
+ */
+
+#define QJS_STACK_MARGIN (64 * 1024)
+
+extern unsigned char __stack_low; /* the bottom of the stack (wasm-ld) */
+
+static size_t qjs_clamp_stack_size(QJSVm *vm, size_t size) {
+    uintptr_t low = (uintptr_t)&__stack_low + QJS_STACK_MARGIN;
+    size_t room = vm->stack_top > low ? vm->stack_top - low : 1;
+    if (size == 0) return 0; /* the host disabled the check */
+    return size < room ? size : room;
+}
+
 /*
  * Create a VM: a runtime with a context (see qjs_new_context for the
  * intrinsics). Does not change the current VM. Returns NULL on failure.
@@ -560,12 +587,14 @@ QJSVm *qjs_vm_new(unsigned int intrinsics) {
     if (!vm) return NULL;
     vm->boxes.prev = vm->boxes.next = &vm->boxes;
 
+    vm->stack_top = (uintptr_t)__builtin_frame_address(0);
     vm->rt = JS_NewRuntime2(&qjs_wasi_malloc_funcs, vm);
     if (!vm->rt) {
         free(vm);
         return NULL;
     }
     JS_SetRuntimeOpaque(vm->rt, vm);
+    JS_SetMaxStackSize(vm->rt, qjs_clamp_stack_size(vm, JS_DEFAULT_STACK_SIZE));
 
     vm->ctx = qjs_new_context(vm->rt, intrinsics);
     if (!vm->ctx) {
@@ -681,9 +710,11 @@ void qjs_set_memory_limit(size_t limit) {
     if (rt) JS_SetMemoryLimit(rt, 0);
 }
 
+/* Set the stack limit of the current VM, within the stack (see
+   qjs_clamp_stack_size); 0 disables the check. */
 __attribute__((export_name("qjs_set_max_stack_size")))
 void qjs_set_max_stack_size(size_t size) {
-    if (rt) JS_SetMaxStackSize(rt, size);
+    if (cur_vm) JS_SetMaxStackSize(rt, qjs_clamp_stack_size(cur_vm, size));
 }
 
 __attribute__((export_name("qjs_run_gc")))
diff --git a/src/index.ts b/src/index.ts
