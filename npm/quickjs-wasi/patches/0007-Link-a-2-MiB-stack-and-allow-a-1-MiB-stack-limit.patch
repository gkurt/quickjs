diff --git a/test/stack.test.ts b/test/stack.test.ts
new file mode 100644
index 0000000..fee2568
--- /dev/null
+++ b/test/stack.test.ts
@@ -0,0 +1,130 @@
+import { describe, it, expect } from 'vitest';
+import { existsSync } from 'node:fs';
+import { Worker } from 'node:worker_threads';
+import { QuickJS, QuickJSInstance, MAX_STACK_SIZE, DEFAULT_STACK_SIZE } from '../src/index.ts';
+import { wasmBytes } from './helpers.ts';
+
+const wasm = new WebAssembly.Module(wasmBytes);
+
+// Recursion through different engine paths: each takes a different
+// share of the WASM stack and of the host's native stack per level.
+const PATTERNS: Record<string, string> = {
+  plain: 'function r() { d++; return r() } r()',
+  map: 'function r() { d++; return [0].map(r) } r()',
+  getter: 'const o = { get x() { d++; return this.x } }; o.x',
+  apply: 'function r() { d++; return Reflect.apply(r, null, []) } r()',
+  json: 'const o = { toJSON() { d++; return JSON.stringify(o) } }; JSON.stringify(o)',
+  proxy: 'const p = new Proxy({}, { get(t, k) { d++; return p[k] } }); p.x',
+  tostring: 'const o = { toString() { d++; return String(o) } }; String(o)',
+  generator: 'function* g() { d++; yield* g() } [...g()]',
+};
+const overflow = (code: string) =>
+  `(() => { let d = 0; try { ${code}; return 'no overflow' } catch (e) { return e.name + ': ' + e.message + ' @' + d } })()`;
+
+// The patterns, run where the host's native stack is `stackSizeMb`: in a
+// worker, which loads the built package (dist/, built before the tests).
+const dist = new URL('../dist/index.js', import.meta.url);
+const runInWorker = (script: string, stackSizeMb: number): Promise<Record<string, string>> =>
+  new Promise((resolve, reject) => {
+    const code = `
+      import { workerData, parentPort } from 'node:worker_threads';
+      const { QuickJS, QuickJSInstance, MAX_STACK_SIZE } = await import(workerData.dist);
+      const wasm = new WebAssembly.Module(workerData.wasmBytes);
+      const out = {};
+      ${script}
+      parentPort.postMessage(out);
+    `;
+    const worker = new Worker(new URL(`data:text/javascript,${encodeURIComponent(code)}`), {
+      workerData: { dist: dist.href, wasmBytes, patterns: PATTERNS, overflow: overflow('CODE') },
+      resourceLimits: { stackSizeMb },
+    });
+    worker.once('message', resolve);
+    worker.once('error', reject);
+  });
+
+describe('stack limits', () => {
+  it('allows up to 1 MiB, and defaults to 512 KiB', async () => {
+    expect(MAX_STACK_SIZE).toBe(1024 * 1024);
+    expect(DEFAULT_STACK_SIZE).toBe(512 * 1024);
+    using vm = await QuickJS.create({ wasm, maxStackSize: MAX_STACK_SIZE });
+    expect(vm.evalCode('1 + 1').consume((h) => h.toNumber())).toBe(2);
+    await expect(QuickJS.create({ wasm, maxStackSize: MAX_STACK_SIZE + 1 })).rejects.toThrow(/maxStackSize/);
+  });
+
+  it('stops recursion cleanly at the default limit, within a 1 MiB host stack', async () => {
+    using vm = await QuickJS.create({ wasm });
+    for (const [name, code] of Object.entries(PATTERNS)) {
+      const result = vm.evalCode(overflow(code)).consume((h) => h.toString());
+      expect(`${name}: ${result}`).toMatch(/: RangeError: Maximum call stack size exceeded @\d+$/);
+      expect(vm.evalCode('1 + 2').consume((h) => h.toNumber())).toBe(3);
+    }
+  });
+
+  it('stops recursion from nested VMs cleanly: they share the stack', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const a = inst.newVm();
+    const b = inst.newVm();
+    a.newFunction('inB', () => a.newString(b.evalCode(overflow(PATTERNS.plain)).consume((h) => h.toString())))
+      .consume((f) => a.setProp(a.global, 'inB', f));
+    // b runs from deep in a's recursion, with the room a left
+    const result = a.evalCode(`
+      function down(n) { return n === 0 ? inB() : down(n - 1) }
+      down(700)
+    `).consume((h) => h.toString());
+    expect(result).toMatch(/^RangeError: Maximum call stack size exceeded @\d+$/);
+    const nestedDepth = Number(result.split('@')[1]);
+    const topDepth = Number(b.evalCode(overflow(PATTERNS.plain)).consume((h) => h.toString()).split('@')[1]);
+    expect(nestedDepth).toBeLessThan(topDepth);
+    expect(a.evalCode(overflow(PATTERNS.plain)).consume((h) => h.toString())).toMatch(/RangeError/);
+  });
+
+  it.skipIf(!existsSync(dist))('stops recursion cleanly at 1 MiB, within a larger host stack', async () => {
+    const out = await runInWorker(`
+      const vm = QuickJS.createSync({ wasm, maxStackSize: MAX_STACK_SIZE });
+      for (const [name, code] of Object.entries(workerData.patterns)) {
+        out[name] = vm.evalCode(workerData.overflow.replace('CODE', code)).consume((h) => h.toString());
+        out[name + ':after'] = vm.evalCode('1 + 2').consume((h) => h.toNumber());
+      }
+      const small = QuickJS.createSync({ wasm });
+      out.defaultPlain = small.evalCode(workerData.overflow.replace('CODE', workerData.patterns.plain)).consume((h) => h.toString());
+    `, 4);
+    for (const name of Object.keys(PATTERNS)) {
+      expect(`${name}: ${out[name]}`).toMatch(/: RangeError: Maximum call stack size exceeded @\d+$/);
+      expect(out[`${name}:after`]).toBe(3);
+    }
+    // twice the recursion depth of the default
+    const depth = (s: string) => Number(s.split('@')[1]);
+    expect(depth(out.plain)).toBeGreaterThan(1.8 * depth(out.defaultPlain));
+  });
+
+  it.skipIf(!existsSync(dist))('keeps a VM created deep in the stack within it', async () => {
+    const out = await runInWorker(`
+      const inst = QuickJSInstance.createSync({ wasm });
+      const a = inst.newVm({ maxStackSize: MAX_STACK_SIZE });
+      // at the bottom of a's recursion, create a VM that asks for the
+      // largest limit, and recurse in it
+      a.newFunction('deep', () => {
+        const c = inst.newVm({ maxStackSize: MAX_STACK_SIZE });
+        try {
+          return a.newString(c.evalCode(workerData.overflow.replace('CODE', workerData.patterns.plain)).consume((h) => h.toString()));
+        } finally {
+          c.dispose();
+        }
+      }).consume((f) => a.setProp(a.global, 'deep', f));
+      out.result = a.evalCode(\`
+        (() => {
+          let result;
+          function down() { try { down() } catch (e) { if (result === undefined) { try { result = deep() } catch (e2) {} } } }
+          down();
+          return result;
+        })()
+      \`).consume((h) => h.toString());
+      out.after = a.evalCode('1 + 2').consume((h) => h.toNumber());
+      const b = inst.newVm();
+      out.fresh = b.evalCode('40 + 2').consume((h) => h.toNumber());
+    `, 4);
+    expect(out.result).toMatch(/^RangeError: Maximum call stack size exceeded @\d+$/);
+    expect(out.after).toBe(3);
+    expect(out.fresh).toBe(42);
+  });
+});
