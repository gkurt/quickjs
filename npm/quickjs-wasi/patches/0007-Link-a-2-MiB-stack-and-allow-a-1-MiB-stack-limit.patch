 /**
  * Largest supported QuickJS native stack limit for the shipped WASM binary.
  *
- * The binary has a 1 MiB linker-defined stack; reserving half of it leaves
+ * The binary has a 2 MiB linker-defined stack; reserving half of it leaves
  * headroom for native frames and stack-overflow exception handling.
+ *
+ * The host engine runs the WASM code on its own native stack, which must
+ * hold the recursion too: each level of guest recursion takes somewhat
+ * more of the host's native stack than of the WASM stack. A limit of
+ * 1 MiB needs about 2 MiB of native stack or more, as on JavaScriptCore,
+ * or in a Node.js worker (4 MiB by default); on a smaller one (Node.js's
+ * main thread has about 1 MiB) deep recursion overflows the host's stack
+ * first, which throws a host `RangeError` out of the call and leaves the
+ * VM unusable. The default, {@link DEFAULT_STACK_SIZE}, fits a 1 MiB
+ * native stack.
  */
-export const MAX_STACK_SIZE = 512 * 1024;
+export const MAX_STACK_SIZE = 1024 * 1024;
+
+/**
+ * The QuickJS stack limit a VM gets when `maxStackSize` is not given,
+ * small enough for recursion to hit QuickJS's "Maximum call stack size
+ * exceeded" before a 1 MiB host native stack overflows. Raise it up to
+ * {@link MAX_STACK_SIZE} on hosts with a larger native stack.
+ */
+export const DEFAULT_STACK_SIZE = 512 * 1024;
 
 /**
  * A host callback behind a QuickJS function (`vm.newFunction()`).
@@ -275,8 +293,15 @@ export interface QuickJSOptions {
   memoryLimit?: number;
   /**
    * Maximum native stack space QuickJS may consume, in bytes.
-   * Must be an integer between 0 and {@link MAX_STACK_SIZE}. Set to 0 to
-   * disable the QuickJS stack guard.
+   * Must be an integer between 0 and {@link MAX_STACK_SIZE}; defaults to
+   * {@link DEFAULT_STACK_SIZE} (see {@link MAX_STACK_SIZE} for the host's
+   * own stack). Set to 0 to disable the QuickJS stack guard.
+   *
+   * The VMs of a {@link QuickJSInstance} share its one stack: a VM
+   * running from the host function of another VM starts deeper in it,
+   * where only the room the other VM left is available. The limit is
+   * measured from where the VM was created, and capped to keep 64 KiB
+   * above the bottom of the stack.
    */
   maxStackSize?: number;
   /**
@@ -1272,7 +1297,7 @@ export class QuickJS {
     inst._current = vm;
 
     // Apply runtime limits
-    QuickJS._applyLimits(vm, opts);
+    QuickJS._applyLimits(vm, opts, true);
 
     return vm;
   }
@@ -1442,12 +1467,15 @@ export class QuickJS {
   }
 
   /** @internal */
-  static _applyLimits(vm: QuickJS, opts: QuickJSVmOptions): void {
+  static _applyLimits(vm: QuickJS, opts: QuickJSVmOptions, restored = false): void {
     if (opts.memoryLimit !== undefined) {
       vm.exports.qjs_set_memory_limit(opts.memoryLimit);
     }
     if (opts.maxStackSize !== undefined) {
       vm.exports.qjs_set_max_stack_size(opts.maxStackSize);
+    } else if (!restored) {
+      // A restored VM keeps the limit of its snapshot
+      vm.exports.qjs_set_max_stack_size(DEFAULT_STACK_SIZE);
     }
     if (opts.interruptHandler) {
       vm.interruptHandler = opts.interruptHandler;
