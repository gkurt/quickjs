+
+  // A host stack of 1 MiB cannot take a 1 MiB WASM stack limit: the host's
+  // RangeError comes out of the call, past the frames of the C code.
+  it.skipIf(!existsSync(dist))('restores the stack pointer when the host overflows, and retires the VM', async () => {
+    const out = await runInWorker(`
+      const inst = QuickJSInstance.createSync({ wasm });
+      const sp = inst._exports.__stack_pointer;
+      const before = sp.value;
+      const a = inst.newVm({ maxStackSize: MAX_STACK_SIZE });
+      const b = inst.newVm();
+      const recurse = 'function r(){r()} try{r()}catch(e){}';
+      let hostError;
+      for (let i = 0; i < 20 && !hostError; i++) {
+        try { a.evalCode(recurse) } catch (e) { hostError = e }
+      }
+      out.overflowed = hostError !== undefined && hostError.constructor.name !== 'JSException';
+      out.spRestored = sp.value === before;
+      out.threwAgain = (() => { try { a.evalCode('1'); return 'no' } catch (e) { return e.message } })();
+      // handles and the VM can still be disposed, and the others go on
+      out.other = b.evalCode('40 + 2').consume((h) => h.toNumber());
+      a.dispose();
+      const c = inst.newVm({ maxStackSize: MAX_STACK_SIZE });
+      out.fresh = c.evalCode('1 + 2').consume((h) => h.toNumber());
+      out.spAfter = sp.value === before;
+    `, 1);
+    expect(out.overflowed).toBe(true);
+    expect(out.spRestored).toBe(true);
+    expect(out.threwAgain).toMatch(/VM is unusable/);
+    expect(out.other).toBe(42);
+    expect(out.fresh).toBe(3);
+    expect(out.spAfter).toBe(true);
+  });
