+  it('gives each VM its own module loader, timezone and rejection handler', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const rejections: string[] = [];
+    const a = inst.newVm({
+      moduleLoader: { load: (name) => `export default "a:${name}"` },
+      timezoneOffset: 0,
+      onUnhandledRejection: (_p, reason) => rejections.push(`a:${reason.toString()}`),
+    });
+    const b = inst.newVm({
+      moduleLoader: { load: (name) => `export default "b:${name}"` },
+      timezoneOffset: -60,
+      onUnhandledRejection: (_p, reason) => rejections.push(`b:${reason.toString()}`),
+    });
+    const importDefault = async (vm: QuickJS) => {
+      const p = vm.evalCode('import m from "mod"; export const v = m;', 'main.js', EvalFlags.TYPE_MODULE);
+      vm.executePendingJobs();
+      const settled = await vm.resolvePromise(p);
+      p.dispose();
+      if (!('value' in settled)) throw new Error('module evaluation failed');
+      return str(settled.value.consume((h) => h.getProp('v')));
+    };
+    expect(await importDefault(a)).toBe('a:mod');
+    expect(await importDefault(b)).toBe('b:mod');
+
+    expect(num(a.evalCode('new Date(0).getTimezoneOffset()'))).toBe(0);
+    expect(num(b.evalCode('new Date(0).getTimezoneOffset()'))).toBe(-60);
+    // b's timezone also inside a's host function
+    a.newFunction('bOffset', () => b.evalCode('new Date(0).getTimezoneOffset()').consume((h) => a.newNumber(h.toNumber())))
+      .consume((f) => a.setProp(a.global, 'bOffset', f));
+    expect(str(a.evalCode('[new Date(0).getTimezoneOffset(), bOffset(), new Date(0).getTimezoneOffset()].join()'))).toBe('0,-60,0');
+
+    a.evalCode('Promise.reject("x")').dispose();
+    a.executePendingJobs();
+    b.evalCode('Promise.reject("y")').dispose();
+    b.executePendingJobs();
+    expect(rejections).toEqual(['a:x', 'b:y']);
+  });
