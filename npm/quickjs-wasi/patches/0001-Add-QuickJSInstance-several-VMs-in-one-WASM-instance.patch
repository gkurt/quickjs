+describe('QuickJSInstance', () => {
+  it('creates independent VMs in one instance', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const a = inst.newVm();
+    const b = inst.newVm();
+    expect(inst.vmCount).toBe(2);
+    a.evalCode('globalThis.x = "a"').dispose();
+    b.evalCode('globalThis.x = "b"').dispose();
+    expect(str(a.evalCode('x'))).toBe('a');
+    expect(str(b.evalCode('x'))).toBe('b');
+    // interleaved handle use: each handle acts on its own VM
+    const ha = a.evalCode('({ v: 1 })');
+    const hb = b.evalCode('({ v: 2 })');
+    expect(num(ha.getProp('v'))).toBe(1);
+    expect(num(hb.getProp('v'))).toBe(2);
+    ha.dispose();
+    hb.dispose();
+    a.dispose();
+    expect(inst.vmCount).toBe(1);
+    expect(str(b.evalCode('x'))).toBe('b');
+  });
