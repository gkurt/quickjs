+  it('collects garbage per VM', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const a = inst.newVm();
+    const b = inst.newVm();
+    b.evalCode('globalThis.keep = []; for (let i = 0; i < 1000; i++) keep.push({ i })').dispose();
+    a.gcThreshold = 0x7fffffff; // no automatic GC in a
+    a.evalCode('for (let i = 0; i < 1000; i++) { const x = { i }; x.self = x }').dispose();
+    const aBefore = a.getMemoryUsage().objCount;
+    const bBefore = b.getMemoryUsage().objCount;
+    a.runGC();
+    expect(a.getMemoryUsage().objCount).toBeLessThan(aBefore - 900);
+    b.runGC();
+    expect(b.getMemoryUsage().objCount).toBe(bBefore);
