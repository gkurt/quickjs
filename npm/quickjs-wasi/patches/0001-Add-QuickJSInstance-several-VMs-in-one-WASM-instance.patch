 /* ---- Module-level state ---- */
 
+/*
+ * A heap-allocated JSValue handed to the host (a "box"). The JSValue comes
+ * first, so a QJSBox* is the JSValue* the host sees. Each box is linked
+ * into the list of the VM it belongs to, so that freeing a VM can release
+ * the values the host never freed (see qjs_vm_free).
+ */
+typedef struct QJSBox QJSBox;
+struct QJSBox {
+    JSValue val;
+    QJSBox *prev;
+    QJSBox *next;
+};
+
+/*
+ * A VM: a runtime with its context, and the state the glue keeps for it.
+ * An instance holds any number of VMs (qjs_vm_new), which share its linear
+ * memory. The runtime's opaque (JS_GetRuntimeOpaque) points back to its VM,
+ * and the VM is the `opaque` of the runtime's malloc functions, so memory
+ * is charged to the runtime that allocates it.
+ */
+typedef struct QJSVm {
+    JSRuntime *rt;
+    JSContext *ctx;
+    /* memory accounting, see qjs_wasi_malloc */
+    size_t mem_limit;   /* 0 = unlimited */
+    size_t mem_used;    /* sum of malloc_usable_size of live allocs */
+    int mem_in_oom;     /* a refusal happened; headroom is open */
+    QJSBox boxes;       /* head of the list of live boxes */
+} QJSVm;
+
+/*
+ * The current VM, whose runtime and context the exports below act on
+ * (qjs_vm_select). `rt` and `ctx` cache its runtime and context.
+ *
+ * Host imports may select another VM (the host function of one VM calling
+ * into another VM), so every trampoline that calls an import saves the
+ * current VM and restores it when the import returns: the code of the
+ * calling VM, and the exports the host calls next on its behalf, see its
+ * runtime again. The host keeps its own notion of the current VM in sync.
+ */
+static QJSVm *cur_vm = NULL;
 static JSRuntime *rt = NULL;
 static JSContext *ctx = NULL;
 
+static void qjs_activate(QJSVm *vm) {
+    cur_vm = vm;
+    rt = vm ? vm->rt : NULL;
+    ctx = vm ? vm->ctx : NULL;
+}
+
+static QJSVm *qjs_vm_of(JSContext *c) {
+    return (QJSVm *)JS_GetRuntimeOpaque(JS_GetRuntime(c));
+}
+
 /* ---- Helper: heap-allocate a JSValue so it can cross the WASM boundary ---- */
 
-static JSValue *jsvalue_to_heap(JSValue val) {
-    JSValue *ptr = (JSValue *)malloc(sizeof(JSValue));
-    if (ptr) {
-        *ptr = val;
+static JSValue *jsvalue_to_heap_vm(QJSVm *vm, JSValue val) {
+    QJSBox *box = (QJSBox *)malloc(sizeof(QJSBox));
+    if (!box)
+        return NULL;
+    box->val = val;
+    if (vm) {
+        box->prev = &vm->boxes;
+        box->next = vm->boxes.next;
+        vm->boxes.next->prev = box;
+        vm->boxes.next = box;
+    } else {
+        box->prev = box->next = box;
     }
-    return ptr;
+    return &box->val;
+}
+
+/* Box a value of the current VM */
+static JSValue *jsvalue_to_heap(JSValue val) {
+    return jsvalue_to_heap_vm(cur_vm, val);
+}
+
+/* Free a box (not the value in it) */
+static void qjs_box_free(JSValue *ptr) {
+    QJSBox *box = (QJSBox *)ptr;
+    box->prev->next = box->next;
+    box->next->prev = box->prev;
+    free(box);
 }
 
