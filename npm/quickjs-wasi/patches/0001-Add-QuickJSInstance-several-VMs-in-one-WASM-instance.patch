+  it('frees a disposed VM while others live, with handles still undisposed', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const a = inst.newVm();
+    const b = inst.newVm();
+    b.evalCode('globalThis.state = { n: 1 }').dispose();
+
+    // leaks: handles, a host function, a pending promise, a cycle
+    const leaked = a.evalCode('globalThis.o = { self: null }; o.self = o; o');
+    const fn = a.newFunction('f', () => a.undefined);
+    const deferred = a.newPromise();
+    a.evalCode('new Promise(() => {})');
+    a.evalCode('[1, 2, 3].map(x => x * 2)');
+    const usedBefore = b.getMemoryUsage().mallocSize;
+
+    a.dispose();
+    expect(inst.vmCount).toBe(1);
+    // disposing handles of a disposed VM is a no-op
+    leaked.dispose();
+    fn.dispose();
+    expect(() => a.evalCode('1')).toThrow(/disposed/);
+    expect(deferred.handle.disposed).toBe(false);
+
+    expect(num(b.evalCode('state.n + 1'))).toBe(2);
+    expect(b.getMemoryUsage().mallocSize).toBe(usedBefore);
+    b.dispose();
+    expect(inst.vmCount).toBe(0);
+  });
+
+  it('reuses the memory of disposed VMs', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const memory = inst._exports.memory;
+    const sizes: number[] = [];
+    for (let i = 0; i < 40; i++) {
+      const vm = inst.newVm();
+      vm.evalCode(`
+        globalThis.data = [];
+        for (let i = 0; i < 2000; i++) data.push({ i, s: "x".repeat(100) + i });
+        globalThis.buf = new Uint8Array(2 * 1024 * 1024);
+      `).dispose();
+      const leak = vm.evalCode('data'); // never disposed: freed with the VM
+      void leak;
+      vm.dispose();
+      sizes.push(memory.buffer.byteLength);
+    }
+    // the memory reached its size in the first iterations, then stays
+    expect(sizes[sizes.length - 1]).toBe(sizes[4]);
+    expect(sizes[sizes.length - 1]).toBeLessThan(32 << 20);
+  });
