+  it('runs nested cross-VM calls and returns to the calling VM', async () => {
+    using inst = await QuickJSInstance.create({ wasm });
+    const a = inst.newVm();
+    const b = inst.newVm();
+
+    // b.callA(n) re-enters a while a is running
+    b.newFunction('callA', (n) => {
+      const r = a.evalCode(`inner(${n.toNumber()})`);
+      const v = r.toNumber();
+      r.dispose();
+      return b.newNumber(v + 1000);
+    }).consume((f) => b.setProp(b.global, 'callA', f));
+    // a.callB(n) calls into b, whose code calls back into a
+    a.newFunction('callB', (n) => {
+      const r = b.evalCode(`callA(${n.toNumber()}) + 1`);
+      const v = r.toNumber();
+      r.dispose();
